generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  READ_ONLY
  SELLER
  OWNER
  ADMIN
  WAREHOUSE
  PURCHASING
}

enum DocumentType {
  QUOTE
  SALE
  PURCHASE
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PlanTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
  PAUSED
}

enum BillingProvider {
  INTERNAL
  STRIPE
}

// ==========================================
// TENANT — Raíz del sistema
// ==========================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  legalName String?
  industry  String?
  countryCode String?
  logoUrl   String?
  brandPrimary String?
  brandSecondary String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    TenantMember[]
  settings   TenantSettings?
  branches   Branch[]
  warehouses Warehouse[]
  categories Category[]
  units      Unit[]
  brands     Brand[]
  products   Product[]
  variants   ProductVariant[]
  customers  Customer[]
  suppliers  Supplier[]
  inventory  Inventory[]
  movements  StockMovement[]
  quotes     Quote[]
  sales      Sale[]
  purchases  Purchase[]
  transfers  InventoryTransfer[]
  subscriptions TenantSubscription[]
  rolePermissions TenantRolePermission[]
  documentCounters DocumentCounter[]

  @@map("tenants")
}

model TenantRolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  role       UserRole
  permission String
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permission])
  @@index([tenantId, role])
  @@index([tenantId, permission])
  @@map("tenant_role_permissions")
}

model DocumentCounter {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  type       DocumentType
  prefix     String
  nextNumber Int          @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("document_counters")
}

model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  tier        PlanTier
  features    Json     @default("{}")
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices        SubscriptionPrice[]
  subscriptions TenantSubscription[]

  @@index([isPublic, isActive])
  @@index([tier, isActive])
  @@map("subscription_plans")
}

model SubscriptionPrice {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @db.Uuid
  nickname        String?
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  interval        BillingInterval
  intervalCount   Int             @default(1)
  trialDays       Int?
  isActive        Boolean         @default(true)
  provider        BillingProvider @default(INTERNAL)
  providerPriceId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plan          SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions TenantSubscription[]

  @@index([planId, isActive])
  @@unique([provider, providerPriceId])
  @@map("subscription_prices")
}

model TenantSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  planId                 String             @db.Uuid
  priceId                String?            @db.Uuid
  status                 SubscriptionStatus @default(ACTIVE)
  isCurrent              Boolean            @default(true)
  startedAt              DateTime           @default(now())
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  provider               BillingProvider    @default(INTERNAL)
  providerCustomerId     String?
  providerSubscriptionId String?
  metadata               Json               @default("{}")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  price  SubscriptionPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)
  events SubscriptionEvent[]

  @@index([tenantId, isCurrent])
  @@index([tenantId, status])
  @@index([planId])
  @@unique([provider, providerSubscriptionId])
  @@map("tenant_subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model TenantMember {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  userId   String   @db.Uuid // UID de auth.users de Supabase
  branchId String?  @db.Uuid
  role     UserRole @default(WAREHOUSE)
  isActive Boolean  @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("tenant_members")
}

model TenantSettings {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @unique @db.Uuid
  currency       String  @default("USD")
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxName        String  @default("Tax")
  quotePrefix    String  @default("QTE-")
  salePrefix     String  @default("SAL-")
  purchasePrefix String  @default("PO-")
  quoteLabel     String  @default("Quote")
  saleLabel      String  @default("Sale")
  purchaseLabel  String  @default("Purchase")
  defaultLocale  String  @default("en")
  timezone       String  @default("UTC")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ==========================================
// INFRAESTRUCTURA FÍSICA
// ==========================================

model Branch {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  name      String
  address   String?
  phone     String?
  isActive  Boolean @default(true)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  members    TenantMember[]
  quotes     Quote[]
  sales      Sale[]

  @@map("branches")
}

model Warehouse {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  branchId  String? @db.Uuid // Nullable — puede ser almacén central
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id])
  inventory Inventory[]
  movements StockMovement[]
  sales     Sale[]
  purchases Purchase[]

  transfersFrom InventoryTransfer[] @relation("FromWarehouse")
  transfersTo   InventoryTransfer[] @relation("ToWarehouse")

  @@map("warehouses")
}

// ==========================================
// CATÁLOGO MAESTRO
// ==========================================

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  parentId String? @db.Uuid
  isActive Boolean @default(true)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Unit {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  name         String
  abbreviation String
  isActive     Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("units")
}

model Brand {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  isActive Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("brands")
}

model Product {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  categoryId   String? @db.Uuid
  brandId      String? @db.Uuid
  unitId       String? @db.Uuid
  name         String
  description  String?
  internalCode String  // Obligatorio — identificador interno del tenant
  sku          String? // Opcional — código externo / barcode
  hasVariants  Boolean @default(false)
  basePrice    Decimal @default(0) @db.Decimal(12, 2)
  baseCost     Decimal @default(0) @db.Decimal(12, 2)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id])
  brand     Brand?          @relation(fields: [brandId], references: [id])
  unit      Unit?           @relation(fields: [unitId], references: [id])
  variants  ProductVariant[]
  inventory Inventory[]

  @@unique([tenantId, internalCode])
  @@index([tenantId, isActive])
  @@index([tenantId, sku])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  productId    String   @db.Uuid
  name         String
  internalCode String
  sku          String?
  attributes   Json     @default("{}") // { "color": "rojo", "talla": "M" }
  price        Decimal? @db.Decimal(12, 2)
  cost         Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@unique([tenantId, internalCode])
  @@index([tenantId, sku])
  @@map("product_variants")
}

// ==========================================
// INVENTARIO
// ==========================================

model Inventory {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  warehouseId    String  @db.Uuid
  productId      String? @db.Uuid // Null si el producto tiene variantes
  variantId      String? @db.Uuid // Null si el producto NO tiene variantes
  quantityOnHand Decimal @default(0) @db.Decimal(12, 3)
  minStock       Decimal @default(0) @db.Decimal(12, 3)
  maxStock       Decimal @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, productId])
  @@unique([warehouseId, variantId])
  @@index([tenantId, warehouseId])
  @@map("inventory")
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  warehouseId String       @db.Uuid
  productId   String?      @db.Uuid
  variantId   String?      @db.Uuid
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3)
  referenceId String?      // ID del documento origen (Sale, Purchase, Transfer)
  notes       String?
  createdAt   DateTime     @default(now())
  createdBy   String?      @db.Uuid // userId de Supabase Auth

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, warehouseId])
  @@index([referenceId])
  @@map("stock_movements")
}

// ==========================================
// CLIENTES Y PROVEEDORES
// ==========================================

model Customer {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  name        String
  legalName   String?
  email       String?
  phone       String?
  taxId       String?
  rfc         String?
  address     String?
  creditLimit Decimal @default(0) @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes Quote[]
  sales  Sale[]

  @@index([tenantId, isActive])
  @@map("customers")
}

model Supplier {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  name         String
  legalName    String?
  email        String?
  phone        String?
  taxId        String?
  rfc          String?
  address      String?
  paymentTerms String?
  notes        String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId, isActive])
  @@map("suppliers")
}

// ==========================================
// COTIZACIONES
// ==========================================

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  customerId       String?     @db.Uuid
  branchId         String      @db.Uuid
  number           String
  status           QuoteStatus @default(DRAFT)
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @default(0) @db.Decimal(12, 2)
  notes            String?
  validUntil       DateTime?
  convertedToSaleId String?    @db.Uuid
  createdBy        String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id])
  branch   Branch      @relation(fields: [branchId], references: [id])
  items    QuoteItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @db.Uuid
  productId   String? @db.Uuid
  variantId   String? @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// ==========================================
// VENTAS
// ==========================================

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  customerId    String?    @db.Uuid
  branchId      String     @db.Uuid
  warehouseId   String     @db.Uuid
  quoteId       String?    @db.Uuid
  number        String
  status        SaleStatus @default(PENDING)
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod String?
  notes         String?
  saleDate      DateTime   @default(now())
  createdBy     String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id])
  branch    Branch     @relation(fields: [branchId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  items     SaleItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, saleDate])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  productId   String? @db.Uuid
  variantId   String? @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  cost        Decimal @default(0) @db.Decimal(12, 2) // Snapshot del costo al momento de la venta
  discount    Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// ==========================================
// COMPRAS
// ==========================================

model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  supplierId   String         @db.Uuid
  warehouseId  String         @db.Uuid
  number       String
  status       PurchaseStatus @default(DRAFT)
  subtotal     Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal        @default(0) @db.Decimal(12, 2)
  total        Decimal        @default(0) @db.Decimal(12, 2)
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdBy    String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  items     PurchaseItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchases")
}

model PurchaseItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseId       String  @db.Uuid
  productId        String? @db.Uuid
  variantId        String? @db.Uuid
  description      String
  quantityOrdered  Decimal @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

// ==========================================
// TRANSFERENCIAS ENTRE ALMACENES
// ==========================================

model InventoryTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  number          String
  status          TransferStatus @default(DRAFT)
  notes           String?
  requestedBy     String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse               @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse               @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items         InventoryTransferItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id                String  @id @default(uuid()) @db.Uuid
  transferId        String  @db.Uuid
  productId         String? @db.Uuid
  variantId         String? @db.Uuid
  quantityRequested Decimal @db.Decimal(12, 3)
  quantitySent      Decimal @default(0) @db.Decimal(12, 3)
  quantityReceived  Decimal @default(0) @db.Decimal(12, 3)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("inventory_transfer_items")
}